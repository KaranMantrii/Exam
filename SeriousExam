    msg.style.color = "red";
    msg.innerText = "Name must be at least 3 characters.";
    return false;
  }
  if (!emailPattern.test(email)) {
    msg.style.color = "red";
    msg.innerText = "Invalid email format.";
    return false;
  }
  if (!phonePattern.test(phone)) {
    msg.style.color = "red";
    msg.innerText = "Phone must be exactly 10 digits.";
    return false;
  }
  if (track === "") {
    msg.style.color = "red";
    msg.innerText = "Please select a track.";
    return false;
  }

  msg.style.color = "green";
  msg.innerText = "Registration Successful!";
  return false; // Prevents page reload so success message remains visible
}

```

